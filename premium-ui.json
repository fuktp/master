{
  "profile": "product-admin",
  "sourceRoots": ["orquestrador_app", "native"],
  "locale": "pt-BR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Table Selection", "Select/Listbox", "Date", "Form", "Scrollbar", "Toast", "CRUD"],
  "ownership": {"Select/Listbox": "native", "Date": "native"},
  "requiredCommands": ["unit", "lint", "types", "visual", "health"],
  "commands": {
    "unit": "QT_QPA_PLATFORM=offscreen .venv/bin/python -m pytest -q",
    "lint": ".venv/bin/ruff check .",
    "types": ".venv/bin/mypy --platform win32",
    "visual": "QT_QPA_PLATFORM=offscreen XDG_CACHE_HOME=/workspace/caio-onboarding/cache .venv/bin/python tools/capture_ui.py --output docs/evidencias/dev11-visual",
    "health": "QT_QPA_PLATFORM=offscreen .venv/bin/python -m orquestrador_app --health-check"
  },
  "evidence": {
    "crudFullFlow": "desktop_tests/test_caio_revision.py",
    "failurePaths": "desktop_tests/test_app_regressions.py"
  }
}
